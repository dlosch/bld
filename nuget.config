<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Every package this repo builds with is on nuget.org. Clearing the inherited sources keeps the
       restore identical on every machine and avoids NU1507 (multiple sources under central package
       management without source mapping), which TreatWarningsAsErrors would turn into a build error. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
