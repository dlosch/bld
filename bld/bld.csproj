<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsAsErrors>true</WarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    <Version>0.2.40</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/dlosch/bld.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Frameworks" />
  </ItemGroup>

  <!-- Ship NuGet.* in bin/nuget and keep them out of deps.json (and so off the runtime's TPA list):
       NuGetAssemblyResolver then loads the newer of our copy and the hosted SDK's. -->
  <Target Name="StageNuGetAssemblies" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_NuGetStagedAssembly Include="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('NuGet.'))" />
      <RuntimeCopyLocalItems Remove="@(_NuGetStagedAssembly)" />
      <ReferenceCopyLocalPaths Include="@(_NuGetStagedAssembly)" DestinationSubDirectory="nuget/" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-bld</ToolCommandName>
    <AssemblyName>dotnet-bld</AssemblyName>
    <PackageProjectUrl>https://github.com/dlosch/bld</PackageProjectUrl>
    <PackageId>dotnet-bld</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>D. Losch / cloudsiders</Authors>
    <Copyright>Copyright © Daniel Losch</Copyright>
    <Description>Tool to clean build output folders for msbuild, dotnet build</Description>
    <PackageTags>tool msbuild clean purge nuget docker rimraf container</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NOTICE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
